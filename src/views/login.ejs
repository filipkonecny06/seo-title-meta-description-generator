<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<main class="auth-main" id="main-content">
  <section class="auth-card glass">
    <h1>Login</h1>
    <p>Access saved generations, favorites, and export history.</p>

    <%# Authentication posts use the server-issued synchronizer token. %>
    <form action="/login" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        Email
        <input type="email" name="email" autocomplete="email" maxlength="180" required />
      </label>

      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" maxlength="72" required />
      </label>

      <button type="submit" class="btn">Sign In</button>
    </form>

    <p class="muted">New here? <a href="/register">Create account</a></p>
  </section>
</main>

<%- include('partials/footer') %>
