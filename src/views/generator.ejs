<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<main class="generator-main" id="main-content" data-generator-page data-authenticated="<%= currentUser ? 'true' : 'false' %>">
  <header class="workspace-intro">
    <p class="eyebrow">Deterministic workspace</p>
    <h1>SEO Snippet Generator</h1>
    <p class="muted">Compare transparent optimization signals. Scores and width checks are guidance, not performance guarantees.</p>
  </header>
  <%# The controller writes concise asynchronous updates for screen readers here. %>
  <p id="generator-status" class="visually-hidden" role="status" aria-live="polite"></p>
  <section class="workspace-grid">
    <%# Browser constraints improve feedback; server schemas remain authoritative. %>
    <aside class="workspace-panel glass config-panel">
      <h2>Configuration</h2>
      <form id="generator-form" autocomplete="off">
        <label>
          Primary Keyword *
          <input type="text" name="primaryKeyword" id="primaryKeyword" placeholder="e.g. project management software" maxlength="180" required />
        </label>

        <label>
          Secondary Keywords / Alternatives
          <input type="text" name="secondaryKeywords" id="secondaryKeywords" placeholder="e.g. Squarespace, Wix" maxlength="500" aria-describedby="secondary-keywords-help" />
          <span id="secondary-keywords-help" class="muted small-text">Add up to 10 comma-separated alternatives, with no more than 100 characters each. Comparison titles and decision-support descriptions use them; the preview highlights them in every style.</span>
        </label>

        <label>
          Audience
          <input type="text" name="audience" id="audience" placeholder="e.g. startups" maxlength="120" />
        </label>

        <label>
          Location
          <input type="text" name="location" id="location" placeholder="e.g. New York" maxlength="120" />
        </label>

        <label>
          Preview URL
          <input type="url" name="pageUrl" id="pageUrl" placeholder="https://example.com/page" maxlength="2048" />
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="includeYear" id="includeYear" checked />
          Include Current Year
        </label>

        <label>
          Search Intent
          <select name="intent" id="intent">
            <option value="informational">Informational</option>
            <option value="commercial">Commercial</option>
            <option value="transactional">Transactional</option>
            <option value="navigational">Navigational</option>
          </select>
        </label>

        <label>
          Tone
          <select name="tone" id="tone">
            <option value="neutral">Neutral</option>
            <option value="authoritative">Authoritative</option>
            <option value="urgent">Urgent</option>
            <option value="friendly">Friendly</option>
          </select>
        </label>
        <p class="muted small-text">Every formula includes a concise marker for the selected intent and tone.</p>

        <label>
          Title Style
          <select name="titleStyle" id="titleStyle">
            <option value="list">List</option>
            <option value="how-to">How-to</option>
            <option value="question">Question</option>
            <option value="comparison">Comparison</option>
            <option value="guide">Guide</option>
          </select>
        </label>

        <label>
          Meta Style
          <select name="metaStyle" id="metaStyle">
            <option value="educational">Educational</option>
            <option value="decision-support">Decision support</option>
            <option value="action-oriented">Action-oriented</option>
          </select>
        </label>

        <label>
          Length Profile
          <select name="length" id="length">
            <option value="short">Short</option>
            <option value="medium" selected>Medium</option>
            <option value="long">Long</option>
          </select>
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="bulkMode" id="bulkMode" />
          Bulk Mode (20 titles)
        </label>

        <div class="control-buttons">
          <button type="submit" class="btn" id="generate-btn">Generate</button>
          <button type="button" class="btn subtle" id="download-btn">Download .txt</button>
          <button type="button" class="btn subtle" id="export-btn">Export CSV</button>
        </div>
      </form>
    </aside>

    <%# GeneratorView escapes user-controlled strings; server-generated IDs and numeric metrics are inserted directly. %>
    <section class="workspace-panel glass results-panel" id="results-panel" aria-busy="false">
      <div class="results-header">
        <h2>Generated Variations</h2>
        <div class="summary-badges" id="summary-badges">
          <span class="pill">Ready</span>
        </div>
      </div>

      <div class="results-toolbar">
        <button type="button" class="btn small" id="save-generation-btn">Save Generation</button>
        <span class="muted small-text"><%= currentUser ? 'Saved generations appear in History.' : 'Login to enable save and favorites.' %></span>
      </div>

      <div class="result-section">
        <h3>Title Variations</h3>
        <div class="card-list" id="title-results" aria-live="polite"></div>
      </div>

      <div class="result-section">
        <h3>Meta Descriptions</h3>
        <div class="card-list" id="meta-results" aria-live="polite"></div>
      </div>

      <div class="compare-panel hidden" id="compare-panel"></div>
    </section>

    <%# Preview markup is sanitized server-side; estimated metrics also expose status text beside visual progress. %>
    <aside class="workspace-panel glass preview-panel">
      <div class="preview-header">
        <h2>Live SERP Preview</h2>
        <div class="toggle-group" role="group" aria-label="Preview device">
          <button type="button" class="toggle-btn active" data-device="desktop" id="desktop-toggle" aria-pressed="true">Desktop</button>
          <button type="button" class="toggle-btn" data-device="mobile" id="mobile-toggle" aria-pressed="false">Mobile</button>
        </div>
      </div>

      <div class="serp-card" id="serp-card">
        <p class="serp-url" id="preview-url">https://www.yourdomain.com</p>
        <h4 class="serp-title" id="preview-title">Generated title will appear here.</h4>
        <p class="serp-meta" id="preview-meta">Generated meta description preview will appear here.</p>
      </div>

      <div class="progress-meters">
        <div>
          <div class="meter-head">
            <span>Estimated title width</span>
            <strong id="title-pixels">0 / 580px</strong>
          </div>
          <progress class="meter-progress" id="title-progress" max="100" value="0">0%</progress>
          <p class="warning-text" id="title-warning" role="status"></p>
        </div>

        <div>
          <div class="meter-head">
            <span>Estimated meta width</span>
            <strong id="meta-pixels">0 / 920px</strong>
          </div>
          <progress class="meter-progress" id="meta-progress" max="100" value="0">0%</progress>
          <p class="warning-text" id="meta-warning" role="status"></p>
        </div>
      </div>

      <div class="schema-box">
        <h3>Schema-Ready Headlines</h3>
        <ul id="schema-suggestions"></ul>
      </div>
    </aside>
  </section>
</main>

<%- include('partials/footer', {
  pageScripts: [
    '/js/generatorUtilities.js',
    '/js/generatorApi.js',
    '/js/generatorExport.js',
    '/js/generatorView.js',
    '/js/generatorController.js',
    '/js/generator.js',
  ],
}) %>
