<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<main class="landing-main" id="main-content">
  <section class="hero-panel glass">
    <div class="hero-copy">
      <p class="eyebrow">Transparent SEO Drafting</p>
      <h1>SEO Title & Meta Description Generator</h1>
      <p>
        Draft repeatable SERP snippets with validated formula context for intent
        and tone, explainable optimization scoring, and width estimates.
      </p>
      <div class="hero-cta">
        <a href="/generator" class="btn">Generate SEO Snippet</a>
        <a href="#workflow" class="btn subtle">Review Workflow</a>
      </div>
      <div class="hero-stats">
        <div>
          <strong>20</strong>
          <span>Title formulas</span>
        </div>
        <div>
          <strong>15</strong>
          <span>Description formulas</span>
        </div>
        <div>
          <strong>4</strong>
          <span>Search intents</span>
        </div>
      </div>
    </div>
    <div class="hero-card glass">
      <h3>What you get</h3>
      <ul>
        <li>Intent- and tone-aware formula context</li>
        <li>Explainable optimization score and badge system</li>
        <li>Character + estimated width checks</li>
        <li>Google-style SERP desktop/mobile preview</li>
        <li>Save history and favorites</li>
        <li>Headline suggestions for review</li>
      </ul>
    </div>
  </section>

  <section class="feature-grid">
    <article class="feature-card glass">
      <h3>Semantic Formula Context</h3>
      <p>Every formula includes a concise action or topic marker for intent and a visible cue for tone.</p>
    </article>
    <article class="feature-card glass">
      <h3>Optimization Scoring</h3>
      <p>Inspect a deterministic rubric for keyword position, weighted words, length, and intent.</p>
    </article>
    <article class="feature-card glass">
      <h3>Pixel Preview</h3>
      <p>Desktop/mobile width estimates with likely-truncation alerts before publishing.</p>
    </article>
    <article class="feature-card glass">
      <h3>Headline Suggestions</h3>
      <p>Copy complete headline candidates into an editorial or structured-data workflow.</p>
    </article>
    <article class="feature-card glass">
      <h3>Save & History</h3>
      <p>Persist generated drafts and keep individual title or description favorites.</p>
    </article>
    <article class="feature-card glass">
      <h3>Bulk Generation</h3>
      <p>Switch to bulk mode to create 20 unique, deterministic title candidates.</p>
    </article>
  </section>

  <section id="workflow" class="comparison glass">
    <h2>Drafting Workflow</h2>
    <div class="comparison-grid">
      <div>
        <h4>1. Describe the page</h4>
        <ul>
          <li>Enter the primary and secondary keywords</li>
          <li>Select intent, tone, and output styles</li>
          <li>Add an audience or location when relevant</li>
        </ul>
      </div>
      <div>
        <h4>2. Review and save</h4>
        <ul>
          <li>Compare complete title and description drafts</li>
          <li>Check the score breakdown and width estimate</li>
          <li>Review for accuracy, then save or export the generated set</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="faq-section glass">
    <h2>FAQ</h2>
    <div class="faq-list">
      <% faqItems.forEach((item) => { %>
        <details>
          <summary><%= item.question %></summary>
          <p><%= item.answer %></p>
        </details>
      <% }) %>
    </div>
  </section>
</main>

<script type="application/ld+json" nonce="<%= cspNonce %>">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}) %>
</script>

<%- include('partials/footer') %>
