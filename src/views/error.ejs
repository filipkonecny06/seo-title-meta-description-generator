<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<main class="error-main" id="main-content">
  <%# The centralized error handler supplies a deliberately public, escaped message. %>
  <section class="glass error-card">
    <p class="eyebrow">Error <%= status %></p>
    <h1>Request Could Not Be Completed</h1>
    <p><%= message %></p>
    <a href="/generator" class="btn">Back to Generator</a>
  </section>
</main>

<%- include('partials/footer') %>
