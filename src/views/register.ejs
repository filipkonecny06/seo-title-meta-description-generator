<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<main class="auth-main" id="main-content">
  <section class="auth-card glass">
    <h1>Create Account</h1>
    <p>Save generated drafts and build a reusable snippet library.</p>

    <form action="/register" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>
        Name
        <input type="text" name="name" autocomplete="name" minlength="2" maxlength="120" required />
      </label>

      <label>
        Email
        <input type="email" name="email" autocomplete="email" maxlength="180" required />
      </label>

      <label>
        Password
        <input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="72" aria-describedby="password-help" required />
        <span id="password-help" class="muted small-text">Use at least 10 characters, no more than 72 UTF-8 bytes, and a password manager.</span>
      </label>

      <button type="submit" class="btn">Create Account</button>
    </form>

    <p class="muted">Already have an account? <a href="/login">Login</a></p>
  </section>
</main>

<%- include('partials/footer') %>
