{
  "name": "seo-title-meta-generator",
  "version": "2.0.0",
  "private": true,
  "description": "Deterministic SEO title and meta description drafting tool",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "npm run format:check && npm run lint && npm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:coverage": "c8 --all --include=src/**/*.js --exclude=src/server.js --exclude=src/config/sequelize-cli.cjs --check-coverage --statements 85 --lines 85 --functions 80 --branches 70 --reporter=text --reporter=lcov --reporter=json-summary node --test && node scripts/checkFileCoverage.js",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "db:migrate": "sequelize-cli db:migrate --config src/config/sequelize-cli.cjs",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/sequelize-cli.cjs",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config src/config/sequelize-cli.cjs",
    "db:provision-demo": "node scripts/provisionDemoAccount.js",
    "db:setup": "npm run db:migrate && npm run db:provision-demo",
    "catalog:validate": "node scripts/validateCatalog.js"
  },
  "keywords": [
    "seo",
    "metadata",
    "serp-preview",
    "express"
  ],
  "author": "Filip Konecny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkonecny06/seo-title-meta-description-generator.git"
  },
  "bugs": {
    "url": "https://github.com/filipkonecny06/seo-title-meta-description-generator/issues"
  },
  "homepage": "https://github.com/filipkonecny06/seo-title-meta-description-generator#readme",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.2",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "dottie": "^2.0.7",
    "lodash": "^4.18.1",
    "uuid": "^11.1.1"
  }
}
