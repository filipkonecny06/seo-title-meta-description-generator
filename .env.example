NODE_ENV=development
# HTTP and security settings. Replace the example session secret locally.
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace_with_at_least_32_random_characters
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=10

# MySQL connection and bounded pool settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=seo_snippets
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
